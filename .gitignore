# Design-pull staging mirror (re-pullable; provenance lives in docs/design-system/)
.design-pull/

# Dev-only artifacts — kept on disk for local reference, not tracked or shipped
# with the theme (review finding M8). The lone screenshot used at runtime by
# patterns/proof-product.php is re-included.
/assets/screenshots/*
!/assets/screenshots/flavor-agent-activity-log.png
# The About showcase's two evidence cards render downscaled WebP derivatives
# of the runtime screenshots; inc/content-images.php names all four.
!/assets/screenshots/flavor-agent-activity-log.webp
!/assets/screenshots/flavor-agent-activity-log-640.webp
!/assets/screenshots/ai-provider-codex-runtime-settings.webp
!/assets/screenshots/ai-provider-codex-runtime-settings-640.webp
/assets/wapuu/_backup-developer-wapuu/
# Design intent (specs + plans) is versioned; the rest of superpowers/ is scratch.
# Note the trailing /* — excluding the directory itself would make the negations
# below unreachable, because git cannot re-include a path under an excluded dir.
/docs/superpowers/*
!/docs/superpowers/specs/
!/docs/superpowers/plans/
/docs/howhperkins.md
/docs/howhperkinswasbuilt.html
/docs/imladris.html

# Superpowers runtime state and operational backups (local dev only). Holds a
# brainstorm session token, server PIDs, and full site content/config dumps that
# belong to the production-operations checkout, not the theme repo.
/.superpowers/

# Playwright MCP / browser automation session artifacts (local dev only)
.playwright-mcp/
docs/blogdocs/**
